# Copy to .env and add your server-side OpenAI API key.
ANALYSIS_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Optional: set a stable random value (32+ characters) for production.
# Locally, the app creates and saves one in data/session.secret automatically.
SESSION_SECRET=
# Optional. Defaults to data/users.db; use a persistent disk path when hosting.
# DATABASE_PATH=data/users.db
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
